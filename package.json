{
  "name": "kubemicrovm-on-chant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "KubeMicroVM adoption kit on chant — three tiers (minimal/prod/prod-ha) over two deploy targets (local floci+m80+k3d, or real AWS+EKS).",
  "scripts": {
    "tsc": "tsc --noEmit",
    "lint": "chant lint src && chant lint cluster",
    "test": "vitest run",
    "build": "npm run tsc",
    "synth:aws-plane": "chant build src/aws-plane --lexicon aws -o dist/aws-plane.template.json",
    "synth:workload": "chant build src/workload --lexicon k8s -o dist/workload.yaml",
    "synth:local-substrate": "chant build src/local-substrate --lexicon k8s -o dist/local-substrate.yaml",
    "synth:golden-image": "chant build src/golden-image --lexicon aws --param goldenImageMode=provision -o dist/golden-image.template.json",
    "ops:build": "chant build ops",
    "synth": "npm run synth:aws-plane && npm run synth:workload"
  },
  "dependencies": {
    "@intentius/chant": "^0.41.15",
    "@intentius/chant-lexicon-aws": "^0.41.15",
    "@intentius/chant-lexicon-forgejo": "^0.41.19",
    "@intentius/chant-lexicon-github": "^0.41.19",
    "@intentius/chant-lexicon-gitlab": "^0.41.19",
    "@intentius/chant-lexicon-helm": "^0.41.15",
    "@intentius/chant-lexicon-k3d": "^0.41.15",
    "@intentius/chant-lexicon-k8s": "^0.41.15",
    "@intentius/chant-lexicon-temporal": "^0.41.15"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.3",
    "js-yaml": "^5.2.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
